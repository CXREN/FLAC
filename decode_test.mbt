///|
/// End-to-end decoding of complete FLAC streams: the `fLaC` marker, metadata,
/// frame headers, subframes, channel decorrelation and the frame CRC-16.

let mono : Bytes = b"\x66\x4c\x61\x43\x80\x00\x00\x22\x00\x10\x00\x10\x00\x00\x00\x00\x00\x00\x0a\xc4\x40\xf0\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xf8\x69\x08\x00\x0f\x30\x02\x00\x00\x00\x64\xff\x9c\x00\xc8\xff\x38\x01\xf4\xfe\x0c\x03\xe8\xfc\x18\x07\xd0\xf8\x30\x13\x88\xec\x78\x27\x10\xd8\xf0\x30\x39\xa0\x5e"

let stereo : Bytes = b"\x66\x4c\x61\x43\x80\x00\x00\x22\x00\x10\x00\x10\x00\x00\x00\x00\x00\x00\x0a\xc4\x42\xf0\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xf8\x69\x18\x00\x0f\x92\x02\x00\x0a\x00\x14\x00\x1e\x00\x28\x00\x32\x00\x3c\x00\x46\x00\x50\x00\x5a\x00\x64\x00\x6e\x00\x78\x00\x82\x00\x8c\x00\x96\x00\xa0\x02\x00\x01\xff\xfe\x00\x03\xff\xfc\x00\x05\xff\xfa\x00\x07\xff\xf8\x00\x09\xff\xf6\x00\x0b\xff\xf4\x00\x0d\xff\xf2\x00\x0f\xff\xf0\x3c\x9d"

let leftside : Bytes = b"\x66\x4c\x61\x43\x80\x00\x00\x22\x00\x10\x00\x10\x00\x00\x00\x00\x00\x00\x0a\xc4\x42\xf0\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xf8\x69\x88\x00\x0f\x3b\x02\x00\x0a\x00\x14\x00\x1e\x00\x28\x00\x32\x00\x3c\x00\x46\x00\x50\x00\x5a\x00\x64\x00\x6e\x00\x78\x00\x82\x00\x8c\x00\x96\x00\xa0\x02\x00\x09\x00\x16\x00\x1b\x00\x2c\x00\x2d\x00\x42\x00\x3f\x00\x58\x00\x51\x00\x6e\x00\x63\x00\x84\x00\x75\x00\x9a\x00\x87\x00\xb0\x0f\xc9"

let rightside : Bytes = b"\x66\x4c\x61\x43\x80\x00\x00\x22\x00\x10\x00\x10\x00\x00\x00\x00\x00\x00\x0a\xc4\x42\xf0\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xf8\x69\x98\x00\x0f\x99\x02\x00\x09\x00\x16\x00\x1b\x00\x2c\x00\x2d\x00\x42\x00\x3f\x00\x58\x00\x51\x00\x6e\x00\x63\x00\x84\x00\x75\x00\x9a\x00\x87\x00\xb0\x02\x00\x01\xff\xfe\x00\x03\xff\xfc\x00\x05\xff\xfa\x00\x07\xff\xf8\x00\x09\xff\xf6\x00\x0b\xff\xf4\x00\x0d\xff\xf2\x00\x0f\xff\xf0\x6a\x4f"

let midside : Bytes = b"\x66\x4c\x61\x43\x80\x00\x00\x22\x00\x10\x00\x10\x00\x00\x00\x00\x00\x00\x0a\xc4\x42\xf0\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xf8\x69\xa8\x00\x0f\x78\x02\x00\x05\x00\x09\x00\x10\x00\x12\x00\x1b\x00\x1b\x00\x26\x00\x24\x00\x31\x00\x2d\x00\x3c\x00\x36\x00\x47\x00\x3f\x00\x52\x00\x48\x02\x00\x09\x00\x16\x00\x1b\x00\x2c\x00\x2d\x00\x42\x00\x3f\x00\x58\x00\x51\x00\x6e\x00\x63\x00\x84\x00\x75\x00\x9a\x00\x87\x00\xb0\x12\xd6"

fn assert_samples(actual : Array[Int], expected : Array[Int]) -> Unit raise {
  assert_true(actual.length() == expected.length())
  for i in 0..<actual.length() {
    assert_true(actual[i] == expected[i])
  }
}

test "decode a mono verbatim stream" {
  let pcm = @flac.decode(mono)
  assert_true(pcm.sample_rate == 44100)
  assert_true(pcm.channels == 1)
  assert_true(pcm.bits_per_sample == 16)
  assert_samples(pcm.samples, [0, 100, -100, 200, -200, 500, -500, 1000, -1000, 2000, -2000, 5000, -5000, 10000, -10000, 12345])
}

test "decode a stereo independent stream" {
  let pcm = @flac.decode(stereo)
  assert_true(pcm.channels == 2)
  assert_samples(pcm.samples, [10, 1, 20, -2, 30, 3, 40, -4, 50, 5, 60, -6, 70, 7, 80, -8, 90, 9, 100, -10, 110, 11, 120, -12, 130, 13, 140, -14, 150, 15, 160, -16])
}

test "decode a left+side stream" {
  let pcm = @flac.decode(leftside)
  assert_true(pcm.channels == 2)
  assert_samples(pcm.samples, [10, 1, 20, -2, 30, 3, 40, -4, 50, 5, 60, -6, 70, 7, 80, -8, 90, 9, 100, -10, 110, 11, 120, -12, 130, 13, 140, -14, 150, 15, 160, -16])
}

test "decode a right+side stream" {
  let pcm = @flac.decode(rightside)
  assert_true(pcm.channels == 2)
  assert_samples(pcm.samples, [10, 1, 20, -2, 30, 3, 40, -4, 50, 5, 60, -6, 70, 7, 80, -8, 90, 9, 100, -10, 110, 11, 120, -12, 130, 13, 140, -14, 150, 15, 160, -16])
}

test "decode a mid+side stream" {
  let pcm = @flac.decode(midside)
  assert_true(pcm.channels == 2)
  assert_samples(pcm.samples, [10, 1, 20, -2, 30, 3, 40, -4, 50, 5, 60, -6, 70, 7, 80, -8, 90, 9, 100, -10, 110, 11, 120, -12, 130, 13, 140, -14, 150, 15, 160, -16])
}

test "decorrelate a mid+side pair with an odd side sample" {
  let mid = [5, 9, 16]
  let side = [9, 22, 27]
  let out = @flac.decorrelate([mid, side], 10)
  assert_samples(out[0], [10, 20, 30])
  assert_samples(out[1], [1, -2, 3])
}
