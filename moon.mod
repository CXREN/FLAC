name = "CXREN/flac"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/CXREN/FLAC"

license = "Apache-2.0"

keywords = [
  "flac",
  "audio",
  "codec",
  "lossless",
  "decoder",
  "pcm",
  "rice",
  "lpc",
  "wav",
  "metadata",
]

preferred_target = "wasm"

description = "Pure-MoonBit FLAC lossless audio decoder: parses stream metadata and decodes frames to PCM with no native dependencies."
