test "verify real stereo24 FLAC against STREAMINFO MD5" {
  assert_true(@flac.verify(stereo24_flac))
}

test "verify real mono24 FLAC against STREAMINFO MD5" {
  assert_true(@flac.verify(mono24_flac))
}

