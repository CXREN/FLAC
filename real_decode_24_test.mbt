test "decode real mono24 FLAC" {
  let pcm = @flac.decode(mono24_flac)
  assert_true(pcm.sample_rate == 8000)
  assert_true(pcm.channels == 1)
  assert_true(pcm.bits_per_sample == 24)
  assert_true(pcm.samples.length() == 256)
  let expected : Array[Int] = [
